NODE_ENV=development
PORT=3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=teraleads
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teraleads
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teraleads_test
RUN_E2E=false

BETTER_AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_chars
BETTER_AUTH_URL=http://localhost:3000
BCRYPT_SALT_ROUNDS=12
AI_PROVIDER=mock
AI_MOCK_FAIL_KEY=__fail_ai__

# Mailer
# MAIL_TRANSPORT defaults to smtp in development/production, json in test
MAIL_TRANSPORT=smtp
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=TeraLeads
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
